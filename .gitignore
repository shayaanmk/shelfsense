# Data — never commit the M5 dataset (large, and Kaggle-licensed)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Commerce simulation state (inventory ledger, PO ledger, sim clock) -- mutable
# runtime state, not reproducible pipeline output; regenerates via commerce.simulate.reset()
data/commerce/*
!data/commerce/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Models / artifacts
*.pkl
*.joblib
*.lgb

# Env / secrets
.env
kaggle.json

# Node / dashboard
node_modules/
dashboard/dist/
dashboard/.vite/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
CLAUDE.md